---
import Base from '../layouts/Base.astro';
import CaseStudy from '../components/CaseStudy.astro';
import ItemGrid from '../components/ItemGrid.astro';
import { existsSync } from 'node:fs';
import { profile, work, earlier, teaching, stack, wip } from '../data/site';

// Drop a photo at public/portrait.jpg. Without one, dev shows a placeholder and production collapses the slot.
const hasPortrait = existsSync('public/portrait.jpg');
const showSlot = hasPortrait || import.meta.env.DEV;

const headline = profile.thesis.replace(profile.thesisHighlight, `<mark>${profile.thesisHighlight}</mark>`);
---
<Base title={profile.title} description={profile.description}>
  <header class="top">
    <div class="wrap">
      <div class="bar">
        <a class="brand" href="#top">{profile.name}</a>
        <nav aria-label="Sections">
          <a href="#work">Work</a>
          <a href="#earlier">Background</a>
          <a href="#stack">Stack</a>
          <a class="btn sm" href={`mailto:${profile.email}`}>Email me</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="hero wrap">
      <h1 set:html={headline} />
      <div class:list={['hero-row', { solo: !showSlot }]}>
        <div>
          <p class="lede">{profile.short}</p>
          <div class="actions">
            <a class="btn" href={`mailto:${profile.email}`}>Email me</a>
            <a class="btn ghost" href={profile.linkedin}>LinkedIn</a>
          </div>
        </div>
        {hasPortrait && (
          <figure class="portrait"><img src="/portrait.jpg" alt={`Portrait of ${profile.name}`} fetchpriority="high" /></figure>
        )}
        {!hasPortrait && showSlot && (
          <figure class="portrait empty"><p>Dev placeholder. Add public/portrait.jpg</p></figure>
        )}
      </div>
    </section>

    <section id="work" class="sec wrap">
      <h2>{work.heading}</h2>
      <p class="sub">{work.intro}</p>
      <div class="cases">
        {work.cases.map((c) => <CaseStudy study={c} />)}
      </div>
      {wip && (
        <div class="wip">
          <div>
            <span class="tag">In progress</span>
            <h3>{wip.title}</h3>
            <p class="sub">{wip.text}</p>
          </div>
          <ul>{wip.bullets.map((b) => <li>{b}</li>)}</ul>
        </div>
      )}
    </section>

    <ItemGrid id="earlier" variant="tiles" heading={earlier.heading} label={earlier.label} items={earlier.items} />
    <ItemGrid id="teaching" variant="list" heading={teaching.heading} label={teaching.label} items={teaching.items} />

    <section id="stack" class="sec wrap">
      <h2>{stack.heading}</h2>
      <dl class="stack">
        {stack.rows.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    </section>
  </main>

  <footer class="close wrap">
    <div class="cta">
      <h2>{profile.tagline}</h2>
      <div class="side">
        <a class="btn" href={`mailto:${profile.email}`}>Email me</a>
        <div class="mail"><span id="mail">{profile.email}</span><button class="btn ghost sm" id="copy" type="button">Copy</button></div>
        <a href={profile.linkedin}>{profile.linkedinLabel}</a>
        <p class="where">{profile.location}</p>
      </div>
    </div>
  </footer>

</Base>

<script>
  const b = document.getElementById('copy');
  const m = document.getElementById('mail');
  b?.addEventListener('click', () => {
    if (!m) return;
    const done = () => { b.textContent = 'Copied'; setTimeout(() => (b.textContent = 'Copy'), 1500); };
    const fallback = () => {
      const r = document.createRange(); r.selectNodeContents(m);
      const s = window.getSelection(); s?.removeAllRanges(); s?.addRange(r);
      b.textContent = 'Selected';
    };
    try { navigator.clipboard.writeText(m.textContent ?? '').then(done, fallback); } catch { fallback(); }
  });
</script>
