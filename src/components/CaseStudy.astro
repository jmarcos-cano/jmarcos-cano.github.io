---
import type { Case } from '../data/site';
import Flow from './Flow.astro';
interface Props { study: Case }
const { study } = Astro.props;
---
<article class="case">
  <div class="facts">
    {study.facts.map((f) => (
      <div class="fact"><b>{f.value}</b><span>{f.label}</span></div>
    ))}
  </div>
  <div>
    <h3>{study.title}</h3>
    <dl>
      <div><dt>Problem</dt><dd>{study.problem}</dd></div>
      <div><dt>Approach</dt><dd>{study.approach}</dd></div>
      <div><dt>Outcome</dt><dd>{study.outcome}</dd></div>
    </dl>
    <ul class="chips">{study.chips.map((c) => <li>{c}</li>)}</ul>
    {study.flow && <Flow />}
  </div>
</article>
