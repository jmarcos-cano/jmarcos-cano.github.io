---
import type { Item } from '../data/site';
interface Props { id: string; heading: string; label: string; items: Item[] }
const { id, heading, label, items } = Astro.props;
---
<section id={id}>
  <div class="head"><h2>{heading}</h2><span class="label">{label}</span></div>
  <div class="pair">
    {items.map((i) => (
      <div class="item">
        <span class="label">{i.kicker}</span>
        <h3>{i.title}</h3>
        <p>{i.text}</p>
      </div>
    ))}
  </div>
</section>
